DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET_KEY=replace-with-a-long-random-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

PRIVACY_MODE=hybrid
LOCAL_EXTRACTION_ENABLED=true
AI_FALLBACK_ENABLED=true

AI_SEND_RAW_DOCUMENTS=false
AI_SEND_SUPPLIER_NAMES=false
AI_SEND_BUYER_NAMES=false
AI_SEND_TRNS=false
AI_SEND_ADDRESSES=false
AI_SEND_EMAILS=false
AI_SEND_INVOICE_NUMBERS=false
AI_SEND_FULL_LINE_DESCRIPTIONS=false

PRIVACY_MAX_AI_INPUT_CHARS=8000
